{
"Version": "2012-10-17",
"Statement": [
{
"Sid": "SovereignLatticeWORMWriteAndVerifyWithTLS",
"Effect": "Allow",
"Action": [
"s3:PutObject",
"s3:GetObject",
"s3:ListBucket"
],
"Resource": [
"arn:aws:s3:::sovereign-lattice-worm-vault",
"arn:aws:s3:::sovereign-lattice-worm-vault/*"
],
"Condition": {
"Bool": {
"aws:SecureTransport": "true"
}
}
}
]
}
