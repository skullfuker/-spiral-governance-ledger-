# Sample environment configuration
# Copy this file to `.env` locally and populate the values required for non-production validation.
# Never commit production credentials or secret material.

STEWARD_NODE_ID=node-local
STEWARD_KEY_ID=steward-key-local
STEWARD_WEBHOOK_URL=https://example.invalid/webhook
STEWARD_WEBHOOK_PLATFORM=discord
STEWARD_AUDIT_MANIFEST_PATH=build/manifests/latest.json
AWS_REGION=us-east-1
